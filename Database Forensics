## I. Target Django model architecture

The target Django design should be aligned to the canonical schema and use one model per domain entity.

### Proposed canonical Django model set

```python
class University(models.Model):
    name = models.CharField(max_length=255)
    access_key = models.CharField(max_length=50, unique=True)
    subscription_date = models.DateField()
    is_active = models.BooleanField(default=True)

class College(models.Model):
    university = models.ForeignKey(University, on_delete=models.CASCADE)
    name = models.CharField(max_length=255)

class Department(models.Model):
    university = models.ForeignKey(University, on_delete=models.CASCADE)
    college = models.ForeignKey(College, on_delete=models.CASCADE)
    name = models.CharField(max_length=255)

class Level(models.Model):
    department = models.ForeignKey(Department, on_delete=models.CASCADE)
    name = models.CharField(max_length=100)

class Course(models.Model):
    university = models.ForeignKey(University, on_delete=models.CASCADE)
    department = models.ForeignKey(Department, on_delete=models.CASCADE)
    level = models.ForeignKey(Level, on_delete=models.CASCADE)
    name = models.CharField(max_length=255)
    code = models.CharField(max_length=50, blank=True, null=True)

class Classroom(models.Model):
    university = models.ForeignKey(University, on_delete=models.CASCADE)
    name = models.CharField(max_length=255)
    room_type = models.CharField(max_length=50)
    camera_ip = models.CharField(max_length=255, blank=True, null=True)

class Lecturer(models.Model):
    university = models.ForeignKey(University, on_delete=models.CASCADE)
    staff_number = models.CharField(max_length=50, blank=True, null=True)
    name = models.CharField(max_length=255)
    email = models.EmailField(blank=True, null=True)
    specialization = models.CharField(max_length=255, blank=True, null=True)

class LecturerCourse(models.Model):
    lecturer = models.ForeignKey(Lecturer, on_delete=models.CASCADE)
    course = models.ForeignKey(Course, on_delete=models.CASCADE)
    level = models.ForeignKey(Level, on_delete=models.CASCADE)
    department = models.ForeignKey(Department, on_delete=models.CASCADE)

class Student(models.Model):
    university = models.ForeignKey(University, on_delete=models.CASCADE)
    department = models.ForeignKey(Department, on_delete=models.SET_NULL, null=True, blank=True)
    level = models.ForeignKey(Level, on_delete=models.SET_NULL, null=True, blank=True)
    student_number = models.CharField(max_length=50)
    name = models.CharField(max_length=255)
    email = models.EmailField(blank=True, null=True)

class StudentBiometric(models.Model):
    student = models.OneToOneField(Student, on_delete=models.CASCADE)
    face_vector = models.JSONField(blank=True, null=True)
    eye_vector = models.JSONField(blank=True, null=True)
    model_version = models.CharField(max_length=100, blank=True, null=True)
    registered_at = models.DateTimeField(auto_now_add=True)

class LecturerBiometric(models.Model):
    lecturer = models.OneToOneField(Lecturer, on_delete=models.CASCADE)
    face_vector = models.JSONField(blank=True, null=True)
    eye_vector = models.JSONField(blank=True, null=True)
    model_version = models.CharField(max_length=100, blank=True, null=True)
    registered_at = models.DateTimeField(auto_now_add=True)

class Schedule(models.Model):
    university = models.ForeignKey(University, on_delete=models.CASCADE)
    department = models.ForeignKey(Department, on_delete=models.CASCADE, null=True, blank=True)
    level = models.ForeignKey(Level, on_delete=models.CASCADE, null=True, blank=True)
    course = models.ForeignKey(Course, on_delete=models.CASCADE, null=True, blank=True)
    lecturer = models.ForeignKey(Lecturer, on_delete=models.SET_NULL, null=True, blank=True)
    classroom = models.ForeignKey(Classroom, on_delete=models.CASCADE)
    day_of_week = models.CharField(max_length=20)
    start_time = models.TimeField()
    end_time = models.TimeField()

class Session(models.Model):
    schedule = models.ForeignKey(Schedule, on_delete=models.CASCADE)
    started_at = models.DateTimeField()
    ended_at = models.DateTimeField(blank=True, null=True)

class Attendance(models.Model):
    session = models.ForeignKey(Session, on_delete=models.CASCADE)
    student = models.ForeignKey(Student, on_delete=models.CASCADE)
    is_present = models.BooleanField(default=False)
    is_excused = models.BooleanField(default=False)
    timestamp = models.DateTimeField(auto_now_add=True)
    note = models.TextField(blank=True, null=True)
    class Meta:
        constraints = [
            models.UniqueConstraint(fields=['session', 'student'], name='uniq_session_student')
        ]
```

### Django-to-DB discrepancy checklist

Discrepancies already visible in the project:

- Legacy and canonical models coexist across different app modules and sometimes duplicate domain concepts.
- `apps/users/models.py` and `apps/students/models.py` both define `University`, `Student`, some schedule/attendance models.
- `apps/biometrics/models.py` canonically uses `Student` and `Doctor`, while the requirement is to canonicalize to `Student`/`Lecturer` only.
